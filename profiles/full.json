{
  "name": "full",
  "description": "Standard profile plus prefetch, recently written executables in user-writable paths, browser extensions and USB history. Can take several minutes.",
  "timeBudgetSeconds": 900,
  "options": {
    "lookbackHours": 168,
    "maxEventsPerCollector": 5000,
    "signatures": true,
    "recentFileDays": 14,
    "maxDepth": 6,
    "maxFiles": 5000
  },
  "collectors": [
    "system_info",
    "network_connections",
    "network_config",
    "dns_cache",
    "arp_cache",
    "hosts_file",
    "proxy_settings",
    "firewall_profiles",
    "smb_sessions",
    "smb_shares",
    "smb_outbound",
    "logged_on_users",
    "local_admins",
    "local_users",
    "processes",
    "autoruns_registry",
    "scheduled_tasks",
    "services",
    "wmi_subscriptions",
    "startup_folders",
    "installed_software",
    "defender",
    "events_security",
    "events_system",
    "events_powershell",
    "events_rdp",
    "events_sysmon",
    "prefetch",
    "recent_executables",
    "browser_extensions",
    "usb_devices"
  ]
}
